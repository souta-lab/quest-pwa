{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "quest-pwa",
  "account_id": "73e4fc6c7371ac0eae00a53fbf21c86d",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "triggers": { "crons": ["0 * * * *"] },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"],
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "quest-pwa",
      "database_id": "f8ce7651-89f2-44fe-9ac9-a6d96a5e81ff",
      "migrations_dir": "migrations",
    },
  ],
  "queues": {
    "producers": [
      { "binding": "GENERATION_QUEUE", "queue": "quest-generation" },
    ],
    "consumers": [
      {
        "queue": "quest-generation",
        "max_batch_size": 1,
        "max_batch_timeout": 1,
        "max_retries": 0,
        "max_concurrency": 3,
      },
    ],
  },
  "vars": { "APP_ORIGIN": "http://localhost:8787" },
}
